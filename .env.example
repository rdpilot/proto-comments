# Copy to .env.local and fill in from your GitHub App settings.

# The numeric App ID from github.com/settings/apps/<your-app>
GITHUB_APP_ID=000000

# The App slug — part of github.com/apps/<this-name>. Used to construct install URLs.
GITHUB_APP_NAME=proto-comments

# base64 of the .pem file you downloaded:
#   cat ~/Downloads/proto-comments.private-key.pem | base64
# (one long line, no newlines)
GITHUB_APP_PRIVATE_KEY_BASE64=
